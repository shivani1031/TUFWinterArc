  class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
        int low = 0;
        int row = matrix.size();  //3
        int col = matrix[0].size();   //4
        int high = col-1;
        while(low<row && high>=0)
        {
        if(matrix[low][high]==target) return true;
        else 
        {
            if(matrix[low][high]>target) high--;
            else low++;
        }
        }
        return false;
    }
};
